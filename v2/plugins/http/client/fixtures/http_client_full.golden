	"io"
	"net/http"
)

type ClientOption func(*clientOptions)

type clientOptions struct {
	ctx    context.Context
	client *http.Client
}

func WithContext(ctx context.Context) ClientOption {
	return func(o *clientOptions) {
		o.ctx = ctx
	}
}

type UserServiceClient struct {
	target string
	opts   clientOptions
}

func NewUserServiceClient(target string, opts ...ClientOption) *UserServiceClient {
	r := &UserServiceClient{target: target}
	for _, o := range opts {
		o(&r.opts)
	}
	return r
}

type UserServiceCreateUserRequest struct {
	c    *UserServiceClient
	opts clientOptions
	req  *full.CreateUserRequest
}

func (r *UserServiceCreateUserRequest) SetReq(v *full.CreateUserRequest) *UserServiceCreateUserRequest {
	r.req = v
	return r
}
func (r *UserServiceCreateUserRequest) Execute(opts ...ClientOption) (string, *full.User, error) {
	for _, o := range opts {
		o(&r.opts)
	}
	ctx, cancel := context.WithCancel(r.opts.ctx)
	defer cancel()
	path := "/user"
	req, err := http.NewRequestWithContext(ctx, "POST", r.c.target+path, nil)
	if err != nil {
		return nil, err
	}
	req.Header.Set("Content-Type", "application/json")
	reqBody, err := json.Marshal(struct {
		Req *full.CreateUserRequest `json:"user_req,omitempty"`
	}{Req: r.req})
	if err != nil {
		return nil, err
	}
	req.Body = io.NopCloser(bytes.NewReader(reqBody))
	resp, err := r.opts.client.Do(req)
	if err != nil {
		return nil, err
	}
	defer resp.Body.Close()
	defer cancel()
	if resp.StatusCode > 399 {
		return nil, fmt.Errorf("http error %d", resp.StatusCode)
	}
	var respBody struct {
		User *full.User `json:"user"`
	}
	if err = json.NewDecoder(resp.Body).Decode(&respBody); err != nil {
		return nil, err
	}
	return respBody.User, nil
}
func (r *UserServiceClient) CreateUser(req *full.CreateUserRequest) (string, *full.User, error) {
	params := UserServiceCreateUserRequest{c: r}
	params.SetReq(req)
	return params.Execute()
}

