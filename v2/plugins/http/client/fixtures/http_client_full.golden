type UserServiceSearchUsersRequest struct {
	c      *UserServiceClient
	opts   clientOptions
	query  string
	limit  int
	offset int
}

func (r *UserServiceSearchUsersRequest) SetQuery(v string) *UserServiceSearchUsersRequest {
	r.query = v
	return r
}
func (r *UserServiceSearchUsersRequest) SetLimit(v int) *UserServiceSearchUsersRequest {
	r.limit = v
	return r
}
func (r *UserServiceSearchUsersRequest) SetOffset(v int) *UserServiceSearchUsersRequest {
	r.offset = v
	return r
}
func (r *UserServiceSearchUsersRequest) Execute(opts ...ClientOption) ([]full.User, int, error) {
	for _, o := range opts {
		o(&r.opts)
	}
	ctx, cancel := context.WithCancel(r.opts.ctx)
	defer cancel()
	path := "/search"
	req, err := http.NewRequestWithContext(ctx, "GET", r.c.target+path, nil)
	if err != nil {
		return nil, 0, err
	}
	q := req.URL.Query()
	q.Set("query", fmt.Sprintf("%v", r.query))
	q.Set("limit_val", fmt.Sprintf("%v", r.limit))
	req.URL.RawQuery = q.Encode()
	req.Header.Set("X-Offset", fmt.Sprintf("%v", r.offset))
	resp, err := r.opts.client.Do(req)
	if err != nil {
		return nil, 0, err
	}
	defer resp.Body.Close()
	defer cancel()
	if resp.StatusCode > 399 {
		return nil, 0, fmt.Errorf("http error %d", resp.StatusCode)
	}
	var respBody struct {
		Users []full.User `json:"users"`
		Total int         `json:"total"`
	}
	if err = json.NewDecoder(resp.Body).Decode(&respBody); err != nil {
		return nil, 0, err
	}
	return respBody.Users, respBody.Total, nil
}
func (r *UserServiceClient) SearchUsers(query string, limit int, offset int) ([]full.User, int, error) {
	params := UserServiceSearchUsersRequest{c: r}
	params.SetQuery(query)
	params.SetLimit(limit)
	params.SetOffset(offset)
	return params.Execute()
}
